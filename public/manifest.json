  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open the admin dashboard",
      "url": "/admin/dashboard",
      "icons": [
        {
          "src": "/img/pwa/shortcut-dashboard-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Students",
      "short_name": "Students",
      "description": "Manage student records",
      "url": "/admin/students",
      "icons": [
        {
          "src": "/img/pwa/shortcut-students-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Staff",
      "short_name": "Staff",
      "description": "Manage staff records",
      "url": "/admin/staff",
      "icons": [
        {
          "src": "/img/pwa/shortcut-staff-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "description": "View system reports",
      "url": "/admin/reports",
      "icons": [
        {
          "src": "/img/pwa/shortcut-reports-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/admin/dashboard",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "documents",
          "accept": [
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/admin/dashboard",
      "accept": {
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gombeapp",
      "url": "/admin/dashboard?protocol=%s"
    }
  ]
}
