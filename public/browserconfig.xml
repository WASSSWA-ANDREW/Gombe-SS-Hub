<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
    <msapplication>
        <tile>
            <square70x70logo src="/img/pwa/icon-72x72.svg"/>
            <square150x150logo src="/img/pwa/icon-144x144.svg"/>
            <square310x310logo src="/img/pwa/icon-384x384.svg"/>
            <TileColor>#3B82F6</TileColor>
            <TileImage src="/img/pwa/icon-144x144.svg"/>
        </tile>
        <notification>
            <polling-uri src="/browserconfig-poll.xml" />
            <polling-uri-period>60</polling-uri-period>
            <polling-uri-frequency>30</polling-uri-frequency>
            <cycle>1</cycle>
        </notification>
    </msapplication>
</browserconfig>
